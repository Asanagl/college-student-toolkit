{
  "name": "college-student-toolkit",
  "version": "0.4.0",
  "description": "大学生 AI 工具组桌面应用",
  "main": "dist-electron/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.node.json && vite build",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:appx": "node scripts/package-appx.cjs",
    "package:store": "node scripts/package-store.cjs",
    "stage:toolchain": "node scripts/stage-toolchain.cjs",
    "build:runner-helper": "node scripts/build-acm-job-runner.cjs",
    "test:runner-helper": "node scripts/test-acm-job-runner.cjs",
    "test:runner-nested": "node scripts/test-acm-job-runner-nested.cjs",
    "test:runner-nested:packaged": "node scripts/test-acm-job-runner-nested.cjs --packaged",
    "verify:appx": "node scripts/verify-appx.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format:check": "prettier --check \"tests/**/*.{ts,tsx}\" \"*.{json,mjs,ts}\" \"scripts/**/*.{cjs,ts}\"",
    "pretest:unit": "npm rebuild better-sqlite3",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:coverage": "npm rebuild better-sqlite3",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:packaged": "playwright test --config playwright.config.ts --project=packaged",
    "test:smoke:package": "node scripts/smoke-package.cjs",
    "test:smoke:appx": "node scripts/smoke-appx.cjs",
    "test:perf": "node scripts/test-perf.cjs",
    "test:perf:release": "node scripts/test-release-perf.cjs",
    "test:perf:release:quick": "cross-env PERF_ITERATIONS=3 PERF_WARMUPS=1 PERF_IDLE_MINUTES=0 PERF_SOAK_MINUTES=0 PERF_ENFORCE=0 node scripts/test-release-perf.cjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:coverage"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "undici": "7.29.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "antd": "^5.17.4",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.0.0",
    "codemirror": "^6.0.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^5.1.0",
    "unzip-stream": "^0.3.2",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/archiver": "^6.0.2",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/unzip-stream": "^0.3.4",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.2.12",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
